# /opt/spcfz-licence-card/licence-card.env on the server, mode 600, owned by root.
# Created once by `tools/deploy.sh env-init`, which fills the four secrets with random values.
# DATA_DIR, HOST and PORT are set by the container image and deploy/run.sh; do not set them here.

BASE_URL=https://licensed.spcfz.ae

# local-proxy: Apache on the same host has already enforced Cloudflare-only, so CF-Connecting-IP is trusted
# when the connection comes from a private or loopback address. See docs/PORT-TO-NODE.md section 5.
TRUST_PROXY=local-proxy

# The ERP's outbound addresses, comma separated. Empty = every webhook is rejected (safe default).
ERP_IP_ALLOWLIST=

# JSON map of ERP field names to canonical names; {} uses the built-in aliases only.
FIELD_MAP={}

GTM_CONTAINER=GTM-PZ8R4DN

WEBHOOK_SECRET_CURRENT=__GENERATED__
WEBHOOK_SECRET_PREVIOUS=
TEST_SECRET_CURRENT=__GENERATED__
TEST_SECRET_PREVIOUS=

# Opens the staff sign-in page: https://licensed.spcfz.ae/admin/login?key=<this>. Without it, /admin is closed (404).
# Generated by env-init; to rotate, put a new 48-character value here and recreate the container (docs/RUNBOOK.md).
ADMIN_LOGIN_KEY=__GENERATED__

# Welcome email (docs/RUNBOOK.md, "Welcome email: turn it on"). off = queued in the admin, not sent.
MAIL_TRANSPORT=off
# Microsoft 365: signed in as more@spcfz.ae, which has Send As on license@spcfz.ae. Port 587, so smtp:// not smtps://.
# MAIL_SMTP_URL=smtp://more%40spcfz.ae:<app password>@smtp.office365.com:587
# MAIL_FROM=SPC Free Zone <license@spcfz.ae>
# MAIL_REPLY_TO=
# MAIL_BCC=
# Who test cards may email: domains or addresses, comma separated. Default spcfz.ae.
# MAIL_TEST_ALLOWLIST=spcfz.ae

# Post to LinkedIn (docs/RUNBOOK.md, "Post to LinkedIn: turn it on"). Hidden until both are set.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# SPC's company page id, for a real @SPC Free Zone mention.
# LINKEDIN_ORG_URN=
# LinkedIn API version, YYYYMM; versions retire after about a year.
# LINKEDIN_API_VERSION=202606
