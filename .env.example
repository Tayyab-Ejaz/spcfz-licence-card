# Copy to .env for `npm run dev`. Never commit .env.
# The container reads deploy/licence-card.env.example instead (docs/RUNBOOK.md).
BASE_URL=http://localhost:8787
DATA_DIR=./data
PORT=8787
# off = the socket peer is the client (local only); production uses local-proxy. See docs/PORT-TO-NODE.md section 5.
TRUST_PROXY=off
# With TRUST_PROXY=off, requests from this machine arrive from 127.0.0.1.
ERP_IP_ALLOWLIST=127.0.0.1
FIELD_MAP={}
GTM_CONTAINER=
TEMPLATE_VERSION=placeholder-1
WEBHOOK_SECRET_CURRENT=dev-production-secret
WEBHOOK_SECRET_PREVIOUS=
TEST_SECRET_CURRENT=dev-test-secret
TEST_SECRET_PREVIOUS=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Leave unset to use puppeteer's downloaded Chrome for Testing; set to use another Chromium.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
