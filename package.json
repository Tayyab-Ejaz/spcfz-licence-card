{
  "name": "spcfz-licence-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Licence-issued social creative for SPC Free Zone customers, served at licensed.spcfz.ae (self-hosted Node 22 service)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.0",
    "jose": "^6.2.0",
    "puppeteer": "^25.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "puppeteer@25.14.0": true
  },
  "engines": {
    "node": ">=22"
  }
}
