{
  "name": "spcfz-licence-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Licence-issued social creative for SPC Free Zone customers, served at licensed.spcfz.ae (self-hosted Node 22 service)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node tools/build-studio.mjs",
    "start": "node dist/server.js",
    "local": "node tools/local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:studio": "node tools/build-studio.mjs",
    "compare-design": "node tools/compare-design.mjs",
    "stress-cards": "node tools/stress-cards.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "html-to-image": "1.11.11",
    "parse5": "^8.0.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "puppeteer@25.14.0": true
  },
  "engines": {
    "node": ">=22"
  }
}
